# Token do bot Discord (obrigatório)
BOT_TOKEN=seu-token-aqui

# --- Docker Compose ---------------------------------------------------------
# Usadas na interpolação do docker-compose.yml (o container recebe as URLs
# internas da rede: postgres:5432, ollama:11434, searxng:8080).
POSTGRES_DB=kate
POSTGRES_USER=kate
POSTGRES_PASSWORD=kate
POSTGRES_PORT=5432

# Modelos do Ollama (o serviço ollama-models baixa/cria automaticamente)
OLLAMA_MODEL=kate
OLLAMA_BASE_MODEL=gemma4:e4b
OLLAMA_SUMMARY_MODEL=gemma4:e4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# --- GPU AMD ---------------------------------------------------------------
# Vulkan (padrão do docker-compose.gpu-amd.yml): não precisa de nenhuma variável.
# ROCm (opcional): rode ./scripts/amd-gpu.sh --write para preencher a linha abaixo.
# RDNA1/RDNA2 (gfx101x/103x) -> 10.3.0 | RDNA3 (gfx1102/1103) -> 11.0.0
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# Volume do Postgres (use compose-amd_postgres_data para reaproveitar a stack antiga)
# POSTGRES_VOLUME=kate_postgres_data

# Store local do Ollama para importar com docker-compose.models-local.yml
# (padrão: ~/.ollama/models)
# OLLAMA_MODELS_DIR=/home/usuario/.ollama/models

# --- Execução local (./gradlew run, fora do Docker) -------------------------
KATE_DB_URL=jdbc:postgresql://localhost:5432/kate
KATE_DB_USER=kate
KATE_DB_PASSWORD=kate
OLLAMA_URL=http://localhost:11434
SEARXNG_URL=http://localhost:8080
WHISPER_MODEL_PATH=models/ggml-base.bin
WHISPER_CLI_PATH=/usr/bin/whisper-cli
PIPER_VOICE_PATH=src/main/resources/voices/pt_BR-dii-high.onnx
KATE_SOUNDS_DIR=lavalink/sounds
KATE_INTRO_SOUND=lavalink/sounds/voce-nao-tem-aura.mp3
